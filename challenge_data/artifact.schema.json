{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heytenor.com/challenges/replay-engine/artifact.schema.json",
  "title": "Replay Engine Artifact Bundle",
  "type": "object",
  "required": ["run", "issues", "replay_case", "change", "matrix", "decision"],
  "properties": {
    "run": {
      "type": "object",
      "required": ["run_id", "selected_issue_id", "parent_version", "candidate_version", "inputs", "started_at", "completed_at"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "selected_issue_id": {"type": "string", "minLength": 1},
        "parent_version": {"$ref": "#/$defs/version"},
        "candidate_version": {"$ref": "#/$defs/version"},
        "inputs": {
          "type": "object",
          "required": ["corpus", "scenario_manifest", "seeds"],
          "properties": {
            "corpus": {"type": "string", "minLength": 1},
            "scenario_manifest": {"type": "string", "minLength": 1},
            "seeds": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "integer"}}
          }
        },
        "started_at": {"type": "string", "minLength": 1},
        "completed_at": {"type": "string", "minLength": 1}
      }
    },
    "issues": {
      "type": "object",
      "required": ["ranked_candidates"],
      "properties": {
        "ranked_candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "rank", "summary", "evidence"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "rank": {"type": "integer", "minimum": 1},
              "summary": {"type": "string", "minLength": 1},
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["trace_id", "locator", "observation"],
                  "properties": {
                    "trace_id": {"type": "string", "minLength": 1},
                    "locator": {"type": "string", "minLength": 1},
                    "observation": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          }
        }
      }
    },
    "replay_case": {
      "type": "object",
      "required": ["issue_id", "scenario_id", "source_state_hash", "observed_evidence", "assumptions", "unknowns", "failure_mode", "failure_predicate"],
      "properties": {
        "issue_id": {"type": "string", "minLength": 1},
        "scenario_id": {"type": "string", "minLength": 1},
        "source_state_hash": {"$ref": "#/$defs/sha256"},
        "observed_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["trace_id", "locator"],
            "properties": {
              "trace_id": {"type": "string", "minLength": 1},
              "locator": {"type": "string", "minLength": 1}
            }
          }
        },
        "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "unknowns": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "failure_mode": {"type": "string", "minLength": 1},
        "failure_predicate": {"type": "string", "minLength": 1}
      }
    },
    "change": {
      "type": "object",
      "required": ["kind", "summary", "parent_version", "candidate_version", "artifact_hash", "evidence"],
      "properties": {
        "kind": {"enum": ["memory", "skill", "prompt", "tool", "hook", "workspace_context", "code"]},
        "summary": {"type": "string", "minLength": 1},
        "parent_version": {"$ref": "#/$defs/version"},
        "candidate_version": {"$ref": "#/$defs/version"},
        "artifact_hash": {"$ref": "#/$defs/sha256"},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "anyOf": [
        {"required": ["diff"], "properties": {"diff": {"type": "string", "minLength": 1}}},
        {"required": ["artifact_path"], "properties": {"artifact_path": {"type": "string", "minLength": 1}}}
      ]
    },
    "matrix": {
      "type": "object",
      "required": ["results"],
      "properties": {
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["scenario_id", "seed", "initial_state_hash", "baseline", "candidate", "severity"],
            "properties": {
              "scenario_id": {"type": "string", "minLength": 1},
              "seed": {"type": "integer"},
              "initial_state_hash": {"$ref": "#/$defs/sha256"},
              "baseline": {"$ref": "#/$defs/outcome"},
              "candidate": {"$ref": "#/$defs/outcome"},
              "severity": {"enum": ["none", "low", "medium", "high", "critical"]}
            }
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "required": ["decision", "policy", "evidence", "summary"],
      "properties": {
        "decision": {"enum": ["promote", "reject"]},
        "summary": {"type": "string", "minLength": 1},
        "policy": {
          "type": "object",
          "required": ["minimum_candidate_score", "maximum_allowed_regression", "block_on_high_severity_regression"],
          "properties": {
            "minimum_candidate_score": {"type": "number", "minimum": 0, "maximum": 1},
            "maximum_allowed_regression": {"type": "number", "minimum": 0},
            "block_on_high_severity_regression": {"const": true}
          }
        },
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "version": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "outcome": {
      "type": "object",
      "required": ["score", "success", "trace_ref", "initial_state_hash", "final_state_hash", "ordered_event_hash"],
      "properties": {
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "success": {"type": "boolean"},
        "trace_ref": {"type": "string", "pattern": "^traces/[A-Za-z0-9._/-]+\\.json$"},
        "initial_state_hash": {"$ref": "#/$defs/sha256"},
        "final_state_hash": {"$ref": "#/$defs/sha256"},
        "ordered_event_hash": {"$ref": "#/$defs/sha256"},
        "cost": {"type": "number", "minimum": 0},
        "latency_ms": {"type": "number", "minimum": 0}
      }
    }
  }
}
